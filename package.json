{
  "name": "fll-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fll-sim/desktop dev",
    "build": "pnpm --filter @fll-sim/desktop build",
    "dist:linux": "pnpm --filter @fll-sim/desktop dist:linux",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "sim": "pnpm --filter @fll-sim/sim-cli exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@12.6.0"
}
